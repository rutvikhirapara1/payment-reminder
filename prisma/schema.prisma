generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  ADMIN
  ACCOUNTS
  VIEWER
}
enum RecordStatus {
  ACTIVE
  INACTIVE
}
enum PaymentMethod {
  BANK_TRANSFER
  NEFT
  RTGS
  IMPS
  UPI
  CHEQUE
  CASH
  OTHER
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(ACCOUNTS)
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  sessions Session[]
  createdObligations VendorPayment[]
  payments Payment[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}
model Vendor {
  id String @id @default(cuid())
  vendorCode String @unique
  vendorName String
  defaultCreditPeriod Int?
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendorPayments VendorPayment[]
}
model VendorPayment {
  id String @id @default(cuid())
  vendorId String
  poId String
  poDate DateTime
  creditPeriodDays Int
  dueDate DateTime
  poAmount Decimal @db.Decimal(14,2)
  notes String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor Vendor @relation(fields: [vendorId], references: [id])
  creator User @relation(fields: [createdBy], references: [id])
  payments Payment[]
  @@unique([vendorId, poId])
  @@index([dueDate])
}
model Payment {
  id String @id @default(cuid())
  vendorPaymentId String
  paymentDate DateTime
  amount Decimal @db.Decimal(14,2)
  paymentMethod PaymentMethod
  transactionReference String?
  notes String?
  createdBy String
  createdAt DateTime @default(now())
  vendorPayment VendorPayment @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id])
}
